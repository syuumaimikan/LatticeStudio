{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lattice Project",
  "type": "object",
  "required": [
    "format_version",
    "name",
    "frame_rate",
    "width",
    "height",
    "tracks",
    "assets"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string"
    },
    "frame_rate": {
      "type": "object",
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "width": {
      "type": "integer",
      "minimum": 16
    },
    "height": {
      "type": "integer",
      "minimum": 16
    },
    "tracks": {
      "type": "array"
    },
    "assets": {
      "type": "array"
    }
  }
}